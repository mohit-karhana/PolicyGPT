# Copy to .env and adjust. Never commit .env.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/policygpt
REDIS_URL=redis://redis:6379/0

# --- Embeddings (used from Phase 4) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Chunking (used from Phase 3) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Retrieval / RAG ---
TOP_K=5
# Any OpenAI-compatible API works. Examples:
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_API_KEY=ollama
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- Uploads (used from Phase 2) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
